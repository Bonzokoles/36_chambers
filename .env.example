# 36 Chambers — host-specific paths and feature flags.
#
# Copy this file to `.env` (next to the project root) and replace every
# placeholder with a real absolute path on your host. The engine resolves all
# locations from these variables via config.py; nothing is hardcoded in source.

# --- Core engine ---
CHAMBERS_REGISTRY=<absolute path to 36_CHAMBERS_REGISTRY.json>
CHAMBERS_TRACE_DIR=<absolute path to the traces directory>
CHAMBERS_GOLDEN_QUERIES=<absolute path to golden_queries.yaml>
CHAMBERS_EVAL_RESULTS=<absolute path to eval_results.csv>
CHAMBERS_EVAL_RUN_DIR=<absolute path to the eval run output directory>
CHAMBERS_ORCHESTRATOR=<absolute path to shaolin_orchestrator.py>
CHAMBERS_ROOT=<absolute path to the project root>

# --- TypeSafe / Jev — AI-powered routing and re-ranking (optional) ---
# Get your free API key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=<your typesafe api key>

# --- Rerank (additive: re-sorts evidence by relevance score) ---
CHAMBERS_RERANK_ENABLED=0                # set to 1 to enable
CHAMBERS_RERANK_URL=<Cohere-compatible /rerank endpoint>   # HTTP reranker (optional)
CHAMBERS_RERANK_API_KEY=<rerank API key>                   # HTTP reranker key (optional)
CHAMBERS_RERANK_MODEL=rerank-v3.5                           # HTTP reranker model

# --- Synthesis (additive: LLM generates cited answer from evidence) ---
CHAMBERS_SYNTHESIS_ENABLED=0            # set to 1 to enable
CHAMBERS_SYNTHESIS_BASE_URL=<OpenAI-compatible endpoint>
CHAMBERS_SYNTHESIS_API_KEY=<API key for synthesis>
CHAMBERS_SYNTHESIS_MODEL=openrouter/auto

# --- Knowledge Observatory ---
CHAMBERS_OBSERVATORY_SQLITE=<absolute path to knowledge_observatory.sqlite>
CHAMBERS_OBSERVATORY_DASHBOARD=<absolute path to the dashboard output directory>
CHAMBERS_OBSERVATORY_EVENTS=<absolute path to events.jsonl>

# --- Security ---
CHAMBERS_SECURITY_DIR=<absolute path to the .security root>

# --- Chamber 08 chat-history store (optional fallback candidates) ---
CHAMBERS_CHAT_DB_PRIMARY=<absolute path to chat.db>
CHAMBERS_CHAT_DB_FALLBACK=<absolute path to an alternative chat.db>

# --- Least-privilege ACL roots (PowerShell template only) ---
DEVZ_KB_ROOT=<absolute path to the DEVz knowledge base>
MEMPALACE_ROOT=<absolute path to the MemPalace store>
SIST2_DATA_ROOT=<absolute path to sist2 data directory>
THE_BUCH_ROOT=<absolute path to the chatbot checkout>

# --- Secrets (not paths) ---
OPENROUTER_MANAGEMENT_KEY=<your OpenRouter management key>